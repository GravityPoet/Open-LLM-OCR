      "desc": "默认保留微软备用地址；选“微软 Document Intelligence”使用。视觉模型请填写对应服务地址。",
      "textConfig": {
        "type": "visible",
        "placeholderText": "https://msft01.cognitiveservices.azure.com/"
      }
    },
    {
      "identifier": "cloudApiKey",
      "type": "text",
