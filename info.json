        {
          "title": "PP-OCR Tiny",
          "value": "pp-ocr-tiny"
        },
        {
          "title": "PP-OCR Medium",
          "value": "pp-ocr-medium"
        },
        {
          "title": "Qwen3-VL 2B",
          "value": "qwen3vl-2b-instruct"
        },
        {
          "title": "Qwen3.5 0.8B",
          "value": "qwen3_5-0.8b"
        },
        {
          "title": "Qwen3.5 2B",
          "value": "qwen3_5-2b"
        },
        {
          "title": "Qwen3.5 4B",
          "value": "qwen3_5-4b"
        },
        {
          "title": "自定义模型 / Workflow",
          "value": "custom"
